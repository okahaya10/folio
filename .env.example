# Sakura VPS environment. Copy to .env, fill in real values, and never
# commit the filled-in .env (see .gitignore — .env* is already ignored).

# Postgres password for the `folio` user/database (docker-compose.yml).
POSTGRES_PASSWORD=

# Same password, URL-encoded (e.g. "/" -> "%2F"), used to build
# DATABASE_URL safely — a raw password with URL-special characters
# breaks postgres connection-string parsing otherwise. Generate with:
#   node -e "console.log(encodeURIComponent(process.argv[1]))" '<password>'
POSTGRES_PASSWORD_URLENC=

# Auth.js session encryption/signing secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Exact hostname that serves the owner's admin site (lib/host-routing.ts).
# Only needed if that hostname's first label isn't literally "admin"
# (e.g. "app.<domain>" was already taken by another app on the VPS, so
# this deployment uses folio-admin.<domain> / folio-app.<domain>).
ADMIN_HOST=

# Only needed outside docker-compose (e.g. running `pnpm build`/tests
# locally against a real Postgres instead of PGlite). Inside compose,
# the app container gets DATABASE_URL from docker-compose.yml instead.
# DATABASE_URL=postgres://folio:<POSTGRES_PASSWORD>@localhost:5432/folio
